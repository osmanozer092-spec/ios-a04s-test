diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -301,6 +301,74 @@ pe_init_fiq(void)
 }
 #endif /* A5XELTE */
+#if defined(A04S)
+/* Exynos850 GIC-400: distributor and CPU interface, both non-secure Group 1. */
+static vm_offset_t a04s_gicd_base;
+static vm_offset_t a04s_gicc_base;
+
+static uint32_t
+a04s_gic_read32(vm_offset_t base, unsigned int offset)
+{
+    return *(volatile uint32_t *)(base + offset);
+}
+
+static void
+a04s_gic_write32(vm_offset_t base, unsigned int offset, uint32_t value)
+{
+    *(volatile uint32_t *)(base + offset) = value;
+}
+
+uint32_t
+a04s_irq_ack(void)
+{
+    return a04s_gic_read32(a04s_gicc_base, 0x00c);
+}
+
+void
+a04s_irq_eoi(uint32_t iar)
+{
+    a04s_gic_write32(a04s_gicc_base, 0x010, iar);
+}
+
+void
+a04s_send_self_ipi(void)
+{
+    __builtin_arm_dsb(DSB_ISHST);
+    a04s_gic_write32(a04s_gicd_base, 0xf00, (2U << 24) | 1U);
+}
+
+void
+pe_init_fiq(void)
+{
+    DTEntry entry;
+    const void *reg;
+    unsigned int size;
+    if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess ||
+        SecureDTGetProperty(entry, "reg", &reg, &size) != kSuccess ||
+        size < 4 * sizeof(uint64_t)) {
+        panic("a04s: missing GICv2 reg in ADT");
+    }
+    const uint64_t *r = reg;
+    vm_offset_t soc = pe_arm_get_soc_base_phys();
+    a04s_gicd_base = ml_io_map(soc + r[0], r[1]);
+    a04s_gicc_base = ml_io_map(soc + r[2], r[3]);
+    if (!a04s_gicd_base || !a04s_gicc_base) {
+        panic("a04s: cannot map GICv2");
+    }
+    /* INTID 27 is the virtual timer PPI; SGI 1 is the local self signal. */
+    a04s_gic_write32(a04s_gicd_base, 0x080,
+        a04s_gic_read32(a04s_gicd_base, 0x080) | (1U << 27) | (1U << 1));
+    for (unsigned int i = 0; i < 32; i += 4) {
+        a04s_gic_write32(a04s_gicd_base, 0x400 + i, 0xa0a0a0a0U);
+    }
+    a04s_gic_write32(a04s_gicd_base, 0x100, (1U << 27) | (1U << 1));
+    a04s_gic_write32(a04s_gicc_base, 0x004, 0xff); /* GICC_PMR */
+    a04s_gic_write32(a04s_gicc_base, 0x008, 0);    /* GICC_BPR */
+    a04s_gic_write32(a04s_gicc_base, 0x000,
+        a04s_gic_read32(a04s_gicc_base, 0x000) | 1U);
+    a04s_gic_write32(a04s_gicd_base, 0x000,
+        a04s_gic_read32(a04s_gicd_base, 0x000) | 1U);
+    __builtin_arm_dsb(DSB_SY);
+    __builtin_arm_isb(ISB_SY);
+}
+#endif /* A04S */
 #endif
